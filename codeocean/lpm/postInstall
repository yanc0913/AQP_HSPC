#!/usr/bin/env bash
# Code Ocean environment build step -- LPM migration capsule.
#
# Base image: Python 3.11 with TensorFlow 2.12 (3.11.14 produced the published
# results). TensorFlow must come from the base image, not from pip here: the
# right build depends on the platform and on whether a GPU is present, which
# is why requirements.txt does not pin it.
#
# numpy is held at 1.x on purpose -- TensorFlow 2.12 and the StarDist stack do
# not work with numpy 2.
#
# The default run (LPM_MODE=labels) never loads TensorFlow; it is needed only
# for LPM_MODE=full, which re-runs StarDist segmentation.
set -euo pipefail

pip install --no-cache-dir -r /code/LPM_migration/requirements.txt
